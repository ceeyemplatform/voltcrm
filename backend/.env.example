# Server configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Postgres Connection (Prisma ORM)
# Use transaction pooler (port 6543) with pgbouncer=true for DATABASE_URL
DATABASE_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) for running migrations
DIRECT_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Project Configuration (Auth verification)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# The service-role (admin) key is not needed by this app; keep it out of this server
